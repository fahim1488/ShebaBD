# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development           # development | production
APP_NAME=ShebaBD AI Backend
APP_VERSION=1.0.0
DEBUG=true

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/shebabd
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=1024
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT=60

# ── JWT Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080       # 7 days

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=30

# ── ShebaBD Internal API (for tool calling) ───────────────────────────────────
# Base URL of your own REST API that the AI tools will call
SHEBABD_API_BASE_URL=http://localhost:8000/api/v1
SHEBABD_API_KEY=internal-service-key
