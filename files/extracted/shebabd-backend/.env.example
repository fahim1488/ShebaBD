NODE_ENV=development
PORT=5000

# Postgres example: postgresql://user:password@localhost:5432/shebabd
# SQLite example (switch provider in prisma/schema.prisma): file:./dev.db
DATABASE_URL=postgresql://user:password@localhost:5432/shebabd

# Generate strong secrets: `openssl rand -base64 48`
JWT_ACCESS_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

CLIENT_ORIGIN=http://localhost:3000

OPENAI_API_KEY=sk-...
AI_MODEL=gpt-4o

# Optional — only needed if cookies must be shared across subdomains
# COOKIE_DOMAIN=.shebabd.com
