generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Swap to "sqlite" for local dev if you don't want to stand up Postgres yet.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  NGO
  VOLUNTEER
  DONOR
  USER
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?
  password  String
  role      Role     @default(USER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chatSessions ChatSession[]

  @@map("users")
}

/// One conversation thread per user with the AI assistant.
model ChatSession {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([userId])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String // "user" | "assistant" | "tool" | "system"
  content   String
  toolCalls Json?
  createdAt DateTime    @default(now())

  @@index([sessionId])
  @@map("chat_messages")
}
